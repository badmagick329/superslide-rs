// Resource 1 is the app icon: Explorer and the shortcut use the first icon in the executable,
// and `shell::app` loads it by this ordinal for the title bar and taskbar.
1 ICON "icon.ico"

// What Properties → Details shows. build.rs defines the VERSION_ macros from Cargo.toml.
1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SuperSlide-RS"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "InternalName", "superslide"
            VALUE "OriginalFilename", "superslide.exe"
            VALUE "ProductName", "SuperSlide-RS"
            VALUE "ProductVersion", VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
